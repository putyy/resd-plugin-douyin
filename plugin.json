{
  "id": "official.douyin",
  "name": "Douyin",
  "author": {
    "name": "putyy",
    "url": "https://github.com/putyy/res-downloader-plugin-douyin"
  },
  "locales": {
    "zh-CN": {
      "name": "抖音",
      "description": "从抖音网页接口识别视频和图文作品；图文作品按可展开合集保存。"
    },
    "zh": {
      "name": "抖音",
      "description": "从抖音网页接口识别视频和图文作品；图文作品按可展开合集保存。"
    },
    "en": {
      "name": "Douyin",
      "description": "Captures Douyin videos and image posts. Image posts are stored as expandable collections."
    }
  },
  "version": "1.0.2",
  "apiVersion": 1,
  "runtime": "javascript",
  "entry": "main.js",
  "priority": 1800,
  "requires": {
    "ffmpeg": ">=6.0"
  },
  "permissions": {
    "domains": [
      "www.douyin.com",
      "www-hj.douyin.com",
      "*.douyinvod.com",
      "*.douyinpic.com",
      "*.douyinstatic.com"
    ],
    "capabilities": [
      "observe-response",
      "read-response-body",
      "emit-resource",
      "media.basic",
      "inject-page-script",
      "page-bridge"
    ],
    "bodyLimit": 16777216
  },
  "match": [
    {
      "stage": "response",
      "host": "www.douyin.com",
      "path": "/aweme/v1/web/aweme/detail/",
      "readBody": true
    },
    {
      "stage": "response",
      "host": "www.douyin.com",
      "path": "/aweme/v1/web/aweme/related/",
      "readBody": true
    },
    {
      "stage": "response",
      "host": "www.douyin.com",
      "path": "/aweme/v1/web/aweme/post/",
      "readBody": true
    },
    {
      "stage": "response",
      "host": "www.douyin.com",
      "path": "/aweme/v1/web/aweme/favorite/",
      "readBody": true
    },
    {
      "stage": "response",
      "host": "www.douyin.com",
      "path": "/aweme/v1/web/tab/feed/",
      "readBody": true
    },
    {
      "stage": "response",
      "host": "www.douyin.com",
      "path": "/aweme/v2/web/module/feed/",
      "readBody": true
    },
    {
      "stage": "response",
      "host": "www.douyin.com",
      "path": "/aweme/v1/web/mix/aweme/",
      "readBody": true
    },
    {
      "stage": "response",
      "host": "www.douyin.com",
      "path": "/",
      "readBody": true,
      "contentTypes": [
        "text/html",
        "text/html;*"
      ]
    },
    {
      "stage": "response",
      "host": "www.douyin.com",
      "path": "/jingxuan*",
      "readBody": true,
      "contentTypes": [
        "text/html",
        "text/html;*"
      ]
    },
    {
      "stage": "response",
      "host": "www.douyin.com",
      "path": "/video/*",
      "readBody": true,
      "contentTypes": [
        "text/html",
        "text/html;*"
      ]
    },
    {
      "stage": "response",
      "host": "www.douyin.com",
      "path": "/note/*",
      "readBody": true,
      "contentTypes": [
        "text/html",
        "text/html;*"
      ]
    },
    {
      "stage": "response",
      "host": "www.douyin.com",
      "path": "/aweme/v1/play/*",
      "readBody": false
    },
    {
      "stage": "response",
      "host": "www-hj.douyin.com",
      "path": "/aweme/v1/web/aweme/detail/",
      "readBody": true
    },
    {
      "stage": "response",
      "host": "www-hj.douyin.com",
      "path": "/aweme/v1/web/aweme/related/",
      "readBody": true
    },
    {
      "stage": "response",
      "host": "www-hj.douyin.com",
      "path": "/aweme/v1/web/aweme/post/",
      "readBody": true
    },
    {
      "stage": "response",
      "host": "www-hj.douyin.com",
      "path": "/aweme/v1/web/aweme/favorite/",
      "readBody": true
    },
    {
      "stage": "response",
      "host": "www-hj.douyin.com",
      "path": "/aweme/v1/web/tab/feed/",
      "readBody": true
    },
    {
      "stage": "response",
      "host": "www-hj.douyin.com",
      "path": "/aweme/v2/web/module/feed/",
      "readBody": true
    },
    {
      "stage": "response",
      "host": "www-hj.douyin.com",
      "path": "/aweme/v1/web/mix/aweme/",
      "readBody": true
    },
    {
      "stage": "response",
      "host": "www-hj.douyin.com",
      "path": "/",
      "readBody": true,
      "contentTypes": [
        "text/html",
        "text/html;*"
      ]
    },
    {
      "stage": "response",
      "host": "www-hj.douyin.com",
      "path": "/jingxuan*",
      "readBody": true,
      "contentTypes": [
        "text/html",
        "text/html;*"
      ]
    },
    {
      "stage": "response",
      "host": "www-hj.douyin.com",
      "path": "/video/*",
      "readBody": true,
      "contentTypes": [
        "text/html",
        "text/html;*"
      ]
    },
    {
      "stage": "response",
      "host": "www-hj.douyin.com",
      "path": "/note/*",
      "readBody": true,
      "contentTypes": [
        "text/html",
        "text/html;*"
      ]
    },
    {
      "stage": "response",
      "host": "www-hj.douyin.com",
      "path": "/aweme/v1/play/*",
      "readBody": false
    },
    {
      "stage": "response",
      "host": "*.douyinvod.com",
      "readBody": false
    },
    {
      "stage": "response",
      "host": "*.douyinpic.com",
      "readBody": false
    },
    {
      "stage": "response",
      "host": "*.douyinstatic.com",
      "readBody": false
    },
    {
      "stage": "response",
      "host": "www.douyin.com",
      "path": "/aweme/v1/web/*",
      "readBody": false
    },
    {
      "stage": "response",
      "host": "www.douyin.com",
      "path": "/aweme/v2/web/*",
      "readBody": false
    },
    {
      "stage": "response",
      "host": "www-hj.douyin.com",
      "path": "/aweme/v1/web/*",
      "readBody": false
    },
    {
      "stage": "response",
      "host": "www-hj.douyin.com",
      "path": "/aweme/v2/web/*",
      "readBody": false
    }
  ],
  "resourceKinds": [
    {
      "id": "media.collection",
      "icon": "albums",
      "color": "#8b5cf6",
      "locales": {
        "zh": {
          "name": "合集"
        },
        "en": {
          "name": "Collection"
        }
      }
    },
    {
      "id": "media.video",
      "icon": "video",
      "color": "#2080f0",
      "locales": {
        "zh": {
          "name": "视频"
        },
        "en": {
          "name": "Video"
        }
      }
    },
    {
      "id": "media.image",
      "icon": "image",
      "color": "#18a058",
      "locales": {
        "zh": {
          "name": "图片"
        },
        "en": {
          "name": "Image"
        }
      }
    },
    {
      "id": "media.audio",
      "icon": "musical-notes",
      "color": "#f0a020",
      "locales": {
        "zh": {
          "name": "音频"
        },
        "en": {
          "name": "Audio"
        }
      }
    }
  ],
  "settingsSchema": {
    "type": "object",
    "properties": {
      "includeImagePostAudio": {
        "type": "boolean",
        "default": true,
        "x-locales": {
          "zh": {
            "name": "包含图文背景音乐",
            "description": "将图文作品的背景音乐作为合集中的独立子资源。"
          },
          "en": {
            "name": "Include image-post audio",
            "description": "Add an image post's soundtrack as a separate collection child."
          }
        }
      },
      "captureScope": {
        "type": "string",
        "enum": [
          "viewed",
          "all"
        ],
        "default": "viewed",
        "x-locales": {
          "zh": {
            "name": "收录范围",
            "description": "默认只收录当前浏览作品；全部接口作品会包含推荐和预加载内容。"
          },
          "en": {
            "name": "Capture scope",
            "description": "Capture viewed works by default; all API works includes recommendations and preloads."
          }
        },
        "x-enumLabels": {
          "zh": {
            "viewed": "当前浏览作品",
            "all": "全部接口作品"
          },
          "en": {
            "viewed": "Viewed works",
            "all": "All API works"
          }
        }
      }
    }
  },
  "pageScripts": [
    {
      "id": "current-work",
      "entry": "page/current-work.js",
      "match": [
        {
          "host": "www.douyin.com",
          "path": "/"
        },
        {
          "host": "www.douyin.com",
          "path": "/jingxuan*"
        },
        {
          "host": "www.douyin.com",
          "path": "/video/*"
        },
        {
          "host": "www.douyin.com",
          "path": "/note/*"
        },
        {
          "host": "www-hj.douyin.com",
          "path": "/"
        },
        {
          "host": "www-hj.douyin.com",
          "path": "/jingxuan*"
        },
        {
          "host": "www-hj.douyin.com",
          "path": "/video/*"
        },
        {
          "host": "www-hj.douyin.com",
          "path": "/note/*"
        }
      ],
      "runAt": "document-start",
      "frames": "top",
      "bridge": true
    }
  ]
}
